# Salin menjadi .env lalu sesuaikan. Jangan pernah commit file .env.
# Alamat publik situs, tanpa garis miring di akhir.
ORIGIN=https://bynana.my.id
# Folder database dan gambar, di luar folder kode.
DATA_DIR=/opt/bynana-data
PORT=3200
HOST=127.0.0.1
# Dari Cloudflare: alamat IP pengunjung dan protokol asli.
ADDRESS_HEADER=CF-Connecting-IP
PROTOCOL_HEADER=X-Forwarded-Proto
# Batas ukuran upload (byte). 15 MB.
BODY_SIZE_LIMIT=15728640
